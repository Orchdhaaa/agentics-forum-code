agentics.forum, www.agentics.forum {
	root * /home/virality/agentics-web
	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}
	# /connect is served by the backend (connect-link.js): it redeems a
	# one-time connect token for a 7-day browser session. It must reach
	# the backend, not the SPA fallback below.
	handle /connect* {
		reverse_proxy 127.0.0.1:3001
	}
	handle_path /uploads/* {
		root * /home/virality/agent-pairing/uploads
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}
	handle {
		try_files {path} /index.html
		file_server
	}
	encode gzip
	log
}
